# Copy to .env.local for local development. On Vercel, set the same keys in
# Project → Settings → Environment Variables.

# Public site URL: canonical URLs, Open Graph, sitemap and robots.txt (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity project (sanity.io/manage). Live site: `production`; local development and seeding: `development`.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=development
# Pinned Content Lake API version (YYYY-MM-DD).
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01

# Viewer token: reads drafts for draft-mode preview. Server-only, never expose it.
SANITY_API_READ_TOKEN=[YOUR_READ_TOKEN]

# Editor token: only used by `npm run seed` to import placeholder content into a development dataset.
# Leave empty in production.
SANITY_API_WRITE_TOKEN=[YOUR_WRITE_TOKEN]

# Shared secret between the Sanity webhook and /api/revalidate (any long random string).
SANITY_REVALIDATE_SECRET=[YOUR_SECRET]
